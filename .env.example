# Copy to .env.local for local development (`npx supabase status` prints the
# local values). On Vercel, set the same names under Project Settings ->
# Environment Variables.

# Public: inlined into the browser bundle. Safe to expose; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only: bypasses RLS. Never prefix with NEXT_PUBLIC_, never commit a
# real value, and on Vercel mark it Sensitive. Used only for account export
# and deletion (later phases).
SUPABASE_SECRET_KEY=sb_secret_xxx
